{
  "name": "anser-data-hub",
  "version": "1.0.0",
  "description": "HUB de API da Anser: extrai dados de ERPs/plataformas (Nibo, Omie, ...), armazena no Supabase e expõe conectores para o BI consumir.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
