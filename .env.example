# Supabase do HUB (projeto novo e dedicado - NÃO é o mesmo Supabase do anser-sete-insight)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Protege as rotas do HUB (companies, credentials, sync, data/*).
# O BI e qualquer outro consumidor deve enviar o header:  x-api-key: <HUB_API_KEY>
HUB_API_KEY=

# Usado pela Vercel para autenticar as chamadas de Cron Job (Settings > Environment Variables).
# Configure o mesmo valor em "Cron Job protection" no dashboard da Vercel.
CRON_SECRET=

# Nibo - API "accountant" (nível escritório contábil), usada para listar as empresas-cliente
# cadastradas no Nibo Contador e as tarefas do escritório. É uma credencial única da Anser,
# não por empresa-cliente (o token por empresa fica na tabela integration_credentials).
NIBO_ACCOUNTANT_API_KEY=
NIBO_ACCOUNTANT_FIRM_ID=

# Porta usada apenas em desenvolvimento local (npm run dev)
PORT=3333

# Teto de requisições/segundo ao Nibo (throttle global do cliente HTTP).
# Padrão: 200ms entre requisições (~5 req/s). Só mude se descobrirmos o
# limite real documentado pelo Nibo — na dúvida, mais conservador é melhor.
NIBO_MIN_REQUEST_INTERVAL_MS=200
